<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence ? "#{content_for(:title)} · par mirror" : "par · community mirror" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Community mirror of par: explore, trade and launch par tokens on Robinhood Chain from the open-source contracts.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>
  <body data-controller="wallet">
    <header class="header">
      <%= link_to root_path, class: "brand" do %>
        <svg width="28" height="28" viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="24" fill="var(--logo-bg)"/><g transform="rotate(-10 50 50)" fill="var(--logo-fg)"><rect x="16" y="26" width="68" height="19" rx="9.5"/><rect x="16" y="55" width="68" height="19" rx="9.5"/></g></svg>
        <span>par</span><span class="badge">community mirror</span>
      <% end %>
      <nav>
        <%= link_to "Explore", root_path, class: ("active" if current_page?(root_path)) %>
        <%= link_to "Create", new_launch_path, class: ("active" if current_page?(new_launch_path)) %>
        <%= link_to "Portfolio", portfolio_path, class: ("active" if request.path == portfolio_path) %>
        <%= link_to "Stats", stats_path, class: ("active" if current_page?(stats_path)) %>
        <%= link_to "Docs", docs_path, target: "_blank" %>
      </nav>
      <button class="btn" data-action="wallet#login" data-wallet-target="button">Connect</button>
    </header>
    <main class="page">
      <%= yield %>
    </main>
    <footer class="footer">
      <p><b>Community mirror of par.</b> Rebuilt from the open-source contracts and SDK after par.family went offline. It reads the same contracts on Robinhood Chain and sends transactions only from your own wallet. It is not operated by the original team and holds no admin keys or protocol fees.</p>
      <p class="muted">Risk notice: transactions are irreversible; tokens can lose all value. Nothing here is financial advice. The contracts are unaudited.</p>
    </footer>
  </body>
</html>
