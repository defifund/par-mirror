<%# Sign-In with Ethereum box; `why` explains what signing in unlocks %>
<div class="card stack" data-controller="siwe">
  <p><%= why %></p>
  <p class="small muted"><%= t("signin.note") %></p>
  <div><button class="btn primary" data-siwe-target="button" data-action="siwe#signIn"><%= t("signin.button") %></button></div>
  <div class="msg" data-siwe-target="msg" hidden></div>
</div>
