<% ref = chain.reference[:symbol] %>
<div data-controller="portfolio" data-portfolio-chain-value="<%= chain.to_public_h.to_json %>" data-portfolio-owner-value="<%= owner %>">
<h2 class="chain-title"><%= chain_badge(chain.slug) %> <%= chain.name %></h2>

    <section class="card">
      <h3><%= t("portfolio.claim_title") %></h3>
      <p class="small muted"><%= t("portfolio.claim_lead", escrow: short(chain.addr(:fee_escrow))) %></p>
      <div data-portfolio-target="claimable" class="small"><%= t("common.loading") %></div>
    </section>

    <section class="card">
      <h3><%= t("portfolio.holdings") %></h3>
      <% if data[:positions].empty? %><p class="muted small"><%= t("portfolio.no_holdings") %><%= t("common.still_syncing") if SyncState.find_by(chain_id: chain.id)&.backfilling %></p><% else %>
        <div class="table-wrap">
        <table class="table">
          <thead><tr><th><%= t("portfolio.col.token") %></th><th><%= t("token.col.balance") %></th><th><%= t("portfolio.col.value") %></th><th><%= t("portfolio.col.bought") %></th><th><%= t("portfolio.col.sold") %></th></tr></thead>
          <tbody>
            <% data[:positions].each do |p| r = p[:launch] %>
              <tr>
                <td><%= link_to token_path(chain: chain.slug, token: r[:token]), class: "row gap" do %><%= token_logo(r, size: 24) %> <%= r[:name] %> <span class="muted">$<%= r[:symbol] %></span><% end %></td>
                <td><%= compact(units(p[:balance])) %></td>
                <td><%= usd(p[:valueUsd]) %> <span class="muted small"><%= compact(p[:valueEth]) %> <%= ref %></span></td>
                <td><%= compact(p[:costEth]) %> <%= ref %></td>
                <td><%= compact(p[:proceedsEth]) %> <%= ref %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% end %>
    </section>

    <section class="card">
      <h3><%= t("portfolio.launched") %></h3>
      <% if data[:launched].empty? %><p class="muted small"><%= t("portfolio.none") %></p><% else %>
        <div class="table-wrap">
        <table class="table">
          <thead><tr><th><%= t("portfolio.col.token") %></th><th><%= t("token.mcap") %></th><th><%= t("portfolio.col.earned") %></th><th><%= t("portfolio.col.mode") %></th></tr></thead>
          <tbody>
            <% data[:launched].each do |r| %>
              <tr>
                <td><%= link_to "#{r[:name]} ($#{r[:symbol]})", token_path(chain: chain.slug, token: r[:token]) %></td>
                <td><%= usd(r[:marketCapUsd]) %></td>
                <td><%= compact(r[:creatorFeesEth]) %> <%= ref %></td>
                <td><%= t("fee_modes.#{r[:feeMode]}.title", default: r[:feeMode].to_s) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        </div>
      <% end %>
    </section>
</div>
