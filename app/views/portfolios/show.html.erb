<% content_for :title, t("portfolio.title"); ref = current_chain.reference[:symbol] %>
<div>
  <h1><%= t("portfolio.title") %></h1>
  <% if @owner.nil? %>
    <div class="card"><p class="muted"><%= t("portfolio.connect_html") %></p>
      <button class="btn primary" data-action="wallet#login"><%= t("js.wallet.connect") %></button></div>
  <% else %>
    <% prof = Profile.find_by(address: @owner) %>
    <% if prof&.name || prof&.bio %>
      <div class="profile-head">
        <% if (img = Par::Pricing.http_url(prof.avatar)) %><%= image_tag img, class: "logo", width: 56, height: 56, alt: "", data: { controller: "fallback", fallback_text_value: prof.name.to_s[0, 2] } %><% end %>
        <div>
          <% if prof.name %><h2><%= prof.name %></h2><% end %>
          <% if prof.bio %><p class="desc"><%= prof.bio %></p><% end %>
          <div class="row gap small"><% prof.socials.each do |k, u| %><% if safe_url(u) %><%= link_to(k == "twitter" ? "X" : t("create.social.#{k}", default: k.capitalize), u, target: "_blank", rel: "noopener nofollow") %><% end %><% end %></div>
        </div>
      </div>
    <% end %>
    <p class="muted mono"><%= @owner %><% if current_wallet == @owner %> · <%= link_to (prof ? t("portfolio.edit_profile") : t("portfolio.add_profile")), profile_path %><% end %></p>
    <% if @sections.empty? %><div class="card"><p class="muted"><%= t("portfolio.nothing") %></p></div><% end %>
    <% @sections.each do |chain, data| %>
      <%= render "portfolios/chain", chain:, data:, owner: @owner %>
    <% end %>
  <% end %>
</div>
