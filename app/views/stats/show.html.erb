<% content_for :title, t("stats.title"); s = @stats; ref = s[:refSymbol]; u = s[:refUsd] %>
<h1><%= t("stats.title") %></h1>
<p class="muted"><%= @chain_tab == "all" ? t("stats.lead_all", chains: Par::Chains.enabled.map(&:name).to_sentence) : t("stats.lead_one", chain: Par::Chains.get(@chain_tab).name) %>
  <% @syncs.select(&:backfilling).each do |sy| %><span class="pill warn"><%= t("stats.replayed", chain: sy.chain.slug.upcase, pct: sy.progress.round(1)) %></span> <% end %></p>
<div class="tabs" style="margin-bottom:16px">
  <% (["all"] + Par::Chains.enabled.map(&:slug)).each do |slug| %>
    <%= link_to(slug == "all" ? t("common.all_chains") : ParHelper::CHAIN_SHORT[slug], stats_path(chain: (slug unless slug == "all"), range: params[:range].presence), class: ("active" if @chain_tab == slug)) %>
  <% end %>
</div>

<% d = @daily; days = d[:days]; span = d[:range] == "all" ? t("stats.all_time") : t("stats.last_days", n: d[:range].delete("d")) %>
<div class="filters">
  <div class="tabs">
    <% %w[7d 30d 90d all].each do |k| %>
      <%= link_to t("stats.range.#{k}"), stats_path(range: k, chain: (@chain_tab unless @chain_tab == "all")), class: ("active" if d[:range] == k) %>
    <% end %>
  </div>
  <button class="btn small" data-controller="copy" data-copy-text-value="<%= stats_text(s, d, @leaders, @chain_tab) %>" data-action="copy#copy"><%= t("stats.copy") %></button>
  <span class="small muted"><%= l(Time.at(d[:from]).utc.to_date, format: :md) %> – <%= l(Time.at(d[:to]).utc.to_date, format: :mdy) %><%= t("stats.latest_day") if @syncs.any?(&:backfilling) %> · <%= @computed_at && Time.now.to_i - @computed_at < 60 ? t("stats.updated_now") : t("stats.updated", ago: t("time.ago", t: ago(@computed_at))) %></span>
</div>


<% w = ->(k) { days.sum { _1[k] } }; at = ->(v) { d[:range] == "all" ? "" : t("stats.all_time_val", v:) + " · " } %>
<div class="stat-tiles">
  <div class="card"><span class="muted small"><%= t("stats.volume") %></span><b><%= usd(w.(:volumeUsd)) %></b><span class="small muted"><%= at.(usd(s[:volumeEth] * u)) %>24h <%= usd(s[:volume24hEth] * u) %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.fees_creators") %></span><b><%= usd(w.(:creatorFeesUsd)) %></b><span class="small muted"><%= at.(usd(s[:creatorFeesGenEth] * u)) %><%= t("stats.collected", v: usd(s[:creatorEarnedEth] * u)) %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.fees_protocol") %></span><b><%= usd(w.(:protocolFeesUsd)) %></b><span class="small muted"><%= at.(usd(s[:protocolFeesGenEth] * u)) %><%= t("stats.collected", v: usd(s[:protocolFeesEth] * u)) %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.new_tokens") %></span><b><%= number_with_delimiter(w.(:launches)) %></b><span class="small muted"><%= t("stats.tokens_sub", total: number_with_delimiter(s[:launches]), traded: s[:launchesTraded], day: s[:launches24h]) %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.trades") %></span><b><%= compact(w.(:trades), 1) %></b><span class="small muted"><%= at.(compact(s[:trades], 1)) %><%= t("stats.in_24h", v: compact(s[:trades24h], 1)) %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.positions") %></span><b><%= compact(s[:holders], 1) %></b><span class="small muted"><%= t("stats.across_tokens", n: s[:tokensWithHolders]) %></span></div>
  <% if s[:par] %>
    <div class="card"><span class="muted small"><%= t("stats.par_burned") %></span><b><%= compact(w.(:parBurned)) %></b><span class="small muted"><%= t("stats.in_total", v: compact(units(s[:par][:burned]))) %><%= @buybacks ? " · " + t("stats.buybacks", n: @buybacks[:count], eth: compact(@buybacks[:ethSpent])) : "" %></span></div>
  <% end %>
</div>

<div class="card">
  <h3><%= t("stats.mirror_title") %></h3>
  <p class="small muted"><%= t("stats.mirror_lead") %><%= t("stats.since_block", n: number_with_delimiter(s[:mirror][:since])) if s[:mirror][:since].to_i.positive? %><%= t("stats.mirror_note") %></p>
  <div class="stat-tiles">
    <div class="card"><span class="muted small"><%= t("stats.tokens") %></span><b><%= s[:mirror][:launches] %></b></div>
    <div class="card"><span class="muted small"><%= t("stats.volume") %></span><b><%= usd(s[:mirror][:volumeEth] * u) %></b><span class="small muted"><%= compact(s[:mirror][:volumeEth]) %> <%= ref %></span></div>
    <div class="card"><span class="muted small"><%= t("stats.paid_creators") %></span><b><%= usd(s[:mirror][:creatorFeesEth] * u) %></b></div>
    <div class="card"><span class="muted small"><%= t("stats.protocol_share") %></span><b><%= usd(s[:mirror][:protocolFeesEth] * u) %></b><span class="small muted"><%= compact(s[:mirror][:protocolFeesEth]) %> <%= ref %></span></div>
  </div>
</div>

<div class="chart-grid">
  <%= render "stats/columns", title: t("stats.volume"), sub: t("stats.c.volume_sub"), total: usd(days.sum { _1[:volumeUsd] }),
             days:, series: [{ key: :volumeUsd, label: t("stats.volume") }], format: "usd" %>
  <%= render "stats/columns", title: t("fees.title"), sub: t("stats.c.fees_sub"), total: usd(days.sum { _1[:creatorFeesUsd] + _1[:protocolFeesUsd] }),
             days:, series: [{ key: :creatorFeesUsd, label: t("stats.c.creators") }, { key: :protocolFeesUsd, label: t("stats.c.protocol") }], format: "usd" %>
  <%= render "stats/columns", title: t("stats.trades"), sub: t("stats.c.trades_sub"), total: number_with_delimiter(days.sum { _1[:trades] }),
             days:, series: [{ key: :trades, label: t("stats.trades") }], format: "count" %>
  <%= render "stats/columns", title: t("stats.c.traders"), sub: t("stats.c.traders_sub"), total: t("stats.c.peak", v: number_with_delimiter(days.map { _1[:traders] }.max.to_i)),
             days:, series: [{ key: :traders, label: t("stats.c.traders_short") }], format: "count" %>
  <%= render "stats/columns", title: t("stats.new_tokens"), sub: t("stats.c.launches_sub"), total: number_with_delimiter(days.sum { _1[:launches] }),
             days:, series: [{ key: :launches, label: t("stats.c.launches") }], format: "count" %>
  <% if @stats[:par] %>
    <%= render "stats/columns", title: t("stats.c.par_burned"), sub: t("stats.c.par_burned_sub"), total: compact(days.sum { _1[:parBurned] }),
               days:, series: [{ key: :parBurned, label: t("stats.par_burned") }], format: "count" %>
  <% end %>
</div>

<% win_creator = days.sum { _1[:creatorFeesUsd] }; win_proto = days.sum { _1[:protocolFeesUsd] } %>
<div class="stat-tiles" style="margin-top:16px">
  <div class="card"><span class="muted small"><%= t("stats.to_creators") %></span><b><%= usd(win_creator) %></b></div>
  <div class="card"><span class="muted small"><%= t("stats.to_protocol") %></span><b><%= usd(win_proto) %></b><span class="small muted"><%= t("stats.to_protocol_sub") %></span></div>
  <div class="card"><span class="muted small"><%= t("stats.paid_holders") %></span><b><%= usd(s[:payoutsEth] * u) %></b><span class="small muted"><%= t("stats.wallet_payouts", n: number_with_delimiter(s[:payouts])) %></span></div>
</div>

<h2 class="section"><%= t("token.holders") %></h2>
<p class="muted small"><%= t("stats.holders_lead") %></p>
<div class="chart-grid">
  <%= render "stats/columns", title: t("stats.c.payouts"), sub: t("stats.c.payouts_sub"), total: usd(days.sum { _1[:payoutsUsd] }),
             days:, series: [{ key: :payoutsUsd, label: t("token.col.paid") }], format: "usd" %>
  <%= render "stats/columns", title: t("stats.c.wallets_paid"), sub: t("stats.c.wallets_paid_sub"), total: t("stats.c.peak", v: number_with_delimiter(days.map { _1[:walletsPaid] }.max.to_i)),
             days:, series: [{ key: :walletsPaid, label: t("stats.c.wallets") }], format: "count" %>
</div>
<div class="stat-tiles">
  <div class="card"><span class="muted small"><%= t("stats.holder_wallets") %></span><b><%= number_with_delimiter(s[:holderWallets]) %></b></div>
  <div class="card"><span class="muted small"><%= t("stats.trader_wallets") %></span><b><%= number_with_delimiter(s[:traderWallets]) %></b></div>
  <div class="card"><span class="muted small"><%= t("stats.payout_rounds") %></span><b><%= number_with_delimiter(days.sum { _1[:payoutRounds] }) %></b><span class="small muted"><%= t("stats.payout_rounds_sub") %></span></div>
</div>

<h2 class="section"><%= t("stats.where") %></h2>
<div class="two-col">
  <div class="col-main card">
    <h3><%= t("stats.by_mode") %></h3>
    <% labels = %w[creator holders burn floor].to_h { [_1, t("fee_modes.#{_1}.title")] }
       n_all = s[:feeModes].sum { _1[:launches] }.nonzero? || 1; f_all = s[:feeModes].sum { _1[:creatorFeesEth] }.nonzero? || 1 %>
    <table class="table"><thead><tr><th><%= t("stats.mode") %></th><th><%= t("stats.tokens") %></th><th><%= t("stats.creator_share_all") %></th></tr></thead><tbody>
      <% s[:feeModes].each do |m| %>
        <tr><td><%= labels[m[:mode]] %></td>
          <td><%= m[:launches] %> <span class="muted small"><%= number_to_percentage(m[:launches] * 100.0 / n_all, precision: 0) %></span></td>
          <td><%= usd(m[:creatorFeesEth] * u) %> <span class="muted small"><%= number_to_percentage(m[:creatorFeesEth] * 100.0 / f_all, precision: 0) %></span></td></tr>
      <% end %>
    </tbody></table>
  </div>
  <div class="col-side card">
    <h3><%= t("stats.split.title") %></h3>
    <table class="table small"><tbody>
      <% %w[pool token quote creator].each do |k| %>
        <tr><td class="muted"><%= t("stats.split.#{k}") %></td><td class="wrap"><%= t("stats.split.#{k}_v") %></td></tr>
      <% end %>
    </tbody></table>
  </div>
</div>

<h2 class="section"><%= t("stats.leaders") %></h2>
<p class="muted small"><%= t("stats.leaders_lead", span:) %></p>
<div class="chart-grid">
  <% %i[volume fees payouts].each do |k| title = t("stats.board.#{k}") %>
    <div class="card">
      <h3><%= title %></h3>
      <% if @leaders[k].empty? %><p class="muted small"><%= t("stats.board.empty") %></p><% else %>
        <table class="table small"><tbody>
          <% @leaders[k].each_with_index do |l, i| %>
            <tr><td class="muted"><%= i + 1 %></td>
              <td><%= link_to "$#{l[:symbol]}", token_path(chain: l[:chain], token: l[:token]) %><% if @chain_tab == "all" %> <%= chain_badge(l[:chain]) %><% end %></td>
              <td class="right"><%= usd(l[:valueUsd]) %></td></tr>
          <% end %>
        </tbody></table>
      <% end %>
    </div>
  <% end %>
</div>

<% if @per_chain %>
  <h2 class="section"><%= t("stats.chains") %></h2>
  <p class="muted small"><%= t("stats.chains_lead") %></p>
  <div class="stat-tiles">
    <% @per_chain.each do |c, st| %>
      <%= link_to stats_path(chain: c.slug, range: params[:range].presence), class: "card chain-card" do %>
        <span class="muted small"><%= chain_badge(c.slug) %> <%= c.name %></span>
        <b><%= usd(st[:volumeEth] * st[:refUsd]) %></b>
        <span class="small muted"><%= t("stats.chain_sub", fees: usd((st[:creatorEarnedEth] + st[:protocolFeesEth]) * st[:refUsd]), n: st[:launches]) %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
