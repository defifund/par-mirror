<%# Holder rewards summary: rounds paid by the original team's distributor through PairPadDisperse(V2) %>
<% d = @distributions %>
<div class="card stack" data-controller="rewards" data-rewards-url-value="/idx/<%= current_chain.id %>/rewards?token=<%= r[:token] %>" data-rewards-assets-value="<%= d[:totals].to_json %>">
  <h3><%= t("rewards.title") %></h3>
  <% if d[:rounds].zero? %>
    <p class="small muted"><%= t("rewards.none") %><%= t("common.still_syncing") if SyncState.find_by(chain_id: current_chain.id)&.extras_cursor.to_i < SyncState.find_by(chain_id: current_chain.id)&.cursor_block.to_i %></p>
  <% else %>
    <table class="table small"><tbody>
      <tr><td class="muted"><%= t("rewards.rounds") %></td><td><%= d[:rounds] %></td></tr>
      <tr><td class="muted"><%= t("rewards.last") %></td><td><%= t("time.ago", t: ago(d[:lastAt])) %>
        <% if d[:lastAt] && d[:lastAt] < 1.day.ago.to_i %><span class="tag warn"><%= t("rewards.stopped") %></span><% end %></td></tr>
      <% d[:totals].each do |tot| %>
        <tr><td class="muted"><%= t("rewards.paid_in", symbol: tot[:symbol]) %></td><td><%= compact(units(tot[:total], tot[:decimals])) %> <%= tot[:symbol] %></td></tr>
      <% end %>
    </tbody></table>
  <% end %>
  <div class="small" data-rewards-target="mine" hidden></div>
  <% if d[:lastAt].nil? || d[:lastAt] < 1.day.ago.to_i %>
    <p class="small muted"><%= t("rewards.explain") %></p>
  <% end %>
</div>
