<%# Floor launches: the locked bid wall per quote, as last placed by PairPadFloorVault %>
<% f = @floor; ref = current_chain.reference[:symbol]; markets = (r[:markets] || [r]).index_by { _1[:pairToken] } %>
<div class="card stack">
  <h3><%= t("floor.title") %></h3>
  <% if f[:walls].empty? %>
    <p class="small muted"><%= t("floor.none_yet") %><%= t("common.still_syncing") if SyncState.find_by(chain_id: current_chain.id)&.extras_cursor.to_i < SyncState.find_by(chain_id: current_chain.id)&.cursor_block.to_i %></p>
  <% else %>
    <table class="table small">
      <thead><tr><th><%= t("floor.quote") %></th><th><%= t("token.col.floor") %></th><th></th></tr></thead>
      <tbody>
        <% f[:walls].each do |w| %>
          <% m = markets[w[:quote]] || {}; mp = m[:lastPriceEth].to_f; fp = w[:floorPriceEth].to_f %>
          <tr>
            <td><%= m[:quoteSymbol] || short(w[:quote]) %></td>
            <td><% if w[:standing] && fp.positive? %><% if @ref_usd.positive? %>$<%= price(fp * @ref_usd) %><% else %><%= price(fp) %> <%= ref %><% end %><% else %><span class="muted"><%= t("common.none") %></span><% end %></td>
            <td><% if w[:standing] && fp.positive? && mp.positive? %>
                  <% if mp < fp %><span class="tag warn" title="<%= t('floor.below_title') %>"><%= t("floor.below") %></span>
                  <% else %><%= t("floor.under", pct: number_to_percentage((1 - fp / mp) * 100, precision: 0)) %><% end %>
                <% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <table class="table small"><tbody>
      <tr><td class="muted"><%= t("floor.last_moved") %></td><td><%= explorer(current_chain, "tx", f[:walls].max_by { _1[:timestamp].to_i }[:txHash], t("time.ago", t: ago(f[:walls].map { _1[:timestamp].to_i }.max))) %></td></tr>
      <tr><td class="muted"><%= t("floor.burned_by_vault") %></td><td><%= compact(units(f[:feeBurnedToken])) %> <%= r[:symbol] %></td></tr>
    </tbody></table>
  <% end %>
  <p class="small muted"><%= t("floor.explain_html") %></p>
</div>
