<% r = @row; ref = current_chain.reference[:symbol]; content_for :title, "#{r[:name]} ($#{r[:symbol]})" %>
<div class="token-head" data-controller="live" data-live-token-value="<%= r[:token] %>" data-live-cursors-value="<%= { current_chain.id => SyncState.where(chain_id: current_chain.id).pick(:cursor_block).to_i }.to_json %>">
  <%= token_logo(r, size: 64) %>
  <div class="grow">
    <h1><%= r[:name] %> <span class="muted">$<%= r[:symbol] %></span></h1>
    <div class="row gap small muted wrap">
      <span class="mono" data-controller="copy" data-copy-text-value="<%= r[:token] %>" data-action="click->copy#copy" title="copy address"><%= short(r[:token]) %> ⧉</span>
      <%= explorer(current_chain, "token", r[:token], "explorer") %>
      <% r[:socials].each do |k, u| %><% if safe_url(u) %><%= link_to({ twitter: "X" }[k] || k.to_s.capitalize, u, target: "_blank", rel: "noopener nofollow") %><% end %><% end %>
      <span>by <%= who(current_chain, r[:deployer]) %> · <%= ago(r[:createdAt]) %> ago</span>
      <%= fee_mode_tag(r[:feeMode]) %>
      <span class="live-dot" data-live-target="dot" title="Updates by itself as new trades are indexed">live</span>
    </div>
    <% if r[:description] %><p class="desc"><%= r[:description] %></p><% end %>
    <% can_edit = TokenProfile.editor?(Launch.new(deployer: r[:deployer], creator_fee_recipient: r[:creatorFeeRecipient]), current_wallet) %>
    <% if r[:editedOnMirror] || can_edit %>
      <p class="small muted">
        <% if r[:editedOnMirror] %>Description, image or links edited by the creator on this mirror.<% end %>
        <% if can_edit %><%= link_to "Edit details", edit_token_path(chain: current_chain.slug, token: r[:token]) %><% end %>
      </p>
    <% end %>
  </div>
</div>

<% if (mode = Par::FeeModes[r[:feeMode]])&.token_note %>
  <div class="msg <%= mode.severity %> risk"><b>Fee mode notice.</b> <%= mode.token_note %></div>
<% end %>

<div class="stats-row" data-live="stats">
  <div><span class="muted small">Price</span><b><% if @ref_usd.positive? %>$<%= price(r[:lastPriceUsd]) %><% else %><%= price(r[:lastPriceEth]) %> <%= ref %><% end %></b></div>
  <div><span class="muted small">Market cap</span><b><%= @ref_usd.positive? ? usd(r[:marketCapUsd]) : "#{compact(r[:marketCapEth])} #{ref}" %></b></div>
  <div><span class="muted small">24h volume</span><b><%= compact(r[:recentVolumeEth]) %> <%= ref %></b></div>
  <div><span class="muted small">Total volume</span><b><%= compact(r[:totalVolumeEth]) %> <%= ref %></b></div>
  <div><span class="muted small">Trades</span><b><%= compact(r[:tradeCount], 1) %></b></div>
  <div><span class="muted small">Holders</span><b><%= compact(r[:holders], 1) %></b></div>
  <div><span class="muted small">Burned</span><b><%= compact(units(r[:burnedToken])) %></b></div>
</div>

<div class="two-col">
  <div class="col-main">
    <div class="card" data-controller="chart" data-chart-url-value="/idx/<%= current_chain.id %>/candles?token=<%= r[:token] %>" data-chart-usd-value="<%= @ref_usd %>" data-chart-ref-value="<%= ref %>">
      <div class="row gap between">
        <div class="tabs small" data-chart-target="intervals">
          <% %w[1m 5m 15m 1h 4h 1d].each do |i| %><button data-action="chart#interval" data-interval="<%= i %>" class="<%= 'active' if i == '15m' %>"><%= i %></button><% end %>
        </div>
        <div class="tabs small" data-chart-target="units">
          <% if @ref_usd.positive? %><button class="active" data-action="chart#unit" data-unit="usd">USD</button><% end %>
          <button class="<%= 'active' unless @ref_usd.positive? %>" data-action="chart#unit" data-unit="ref"><%= ref %></button>
        </div>
      </div>
      <div class="chart" data-chart-target="canvas"></div>
      <div class="muted small" data-chart-target="empty" hidden>No trades indexed in this window yet.</div>
    </div>

    <div class="card" data-controller="tabs">
      <div class="tabs">
        <button class="active" data-action="tabs#show" data-tab="trades">Trades</button>
        <button data-action="tabs#show" data-tab="holders">Holders (<span data-live="n-holders"><%= @holders[:holders] %></span>)</button>
        <% if @distributions %><button data-action="tabs#show" data-tab="rewards">Rewards (<%= @distributions[:rounds] %>)</button><% end %>
        <button data-action="tabs#show" data-tab="burns">Burns (<span data-live="n-burns"><%= @burn_total %></span>)</button>
        <% if @floor %><button data-action="tabs#show" data-tab="floor">Floor</button><% end %>
        <button data-action="tabs#show" data-tab="info">Info</button>
      </div>
      <div data-tabs-target="panel" data-tab="trades" class="scroll" data-live="trades">
        <table class="table small">
          <thead><tr><th>Age</th><th>Side</th><th><%= ref %></th><th><%= r[:symbol] %></th><th>Price</th><th>Trader</th></tr></thead>
          <tbody>
            <% @trades.each do |t| %>
              <tr data-key="<%= t[:txHash] %>-<%= t[:logIndex] %>">
                <td><%= explorer(current_chain, "tx", t[:txHash], ago(t[:timestamp])) %></td>
                <td class="<%= t[:isBuy] ? 'up' : 'down' %>"><%= t[:isBuy] ? "Buy" : "Sell" %><%= " · #{t[:quoteSymbol]}" if t[:market] %></td>
                <td><%= compact(t[:valueEth]) %></td>
                <td><%= compact(units(t[:tokenAmount])) %></td>
                <td><% if @ref_usd.positive? %>$<%= price(t[:priceEth].to_f * @ref_usd) %><% else %><%= price(t[:priceEth]) %><% end %></td>
                <td class="mono"><%= t[:trader] ? who(current_chain, t[:trader]) : "…" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @trades.empty? %><div class="muted small pad">No trades indexed yet.</div><% end %>
      </div>
      <div data-tabs-target="panel" data-tab="holders" class="scroll" data-live="holders" hidden>
        <p class="small muted"><%= @holders[:holders] %> holders · <%= compact(units(@holders[:inPools])) %> <%= r[:symbol] %> still in the pool<%= "s" if r[:marketCount] > 1 %></p>
        <% labels = current_chain.addresses.to_h { |k, a| [a.downcase, k.to_s] } %>
        <table class="table small">
          <thead><tr><th>#</th><th>Holder</th><th>Balance</th><th>Share</th></tr></thead>
          <tbody>
            <% @holders[:items].each_with_index do |h, i| %>
              <tr>
                <td><%= i + 1 %></td>
                <td class="mono"><%= who(current_chain, h[:owner]) %>
                  <% if h[:owner] == r[:deployer] %><span class="tag">creator</span><% end %>
                  <% if labels[h[:owner]] %><span class="tag"><%= labels[h[:owner]].humanize.downcase %></span><% end %></td>
                <td><%= compact(units(h[:balance])) %></td>
                <td><%= number_to_percentage(h[:share] * 100, precision: 2) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <% if @distributions %>
      <div data-tabs-target="panel" data-tab="rewards" class="scroll" hidden>
        <table class="table small">
          <thead><tr><th>Age</th><th>Round</th><th>Asset</th><th>Paid</th><th>Holders</th></tr></thead>
          <tbody>
            <% @distributions[:items].each do |d| %>
              <tr>
                <td><%= explorer(current_chain, "tx", d[:txHash], ago(d[:timestamp])) %></td>
                <td class="mono small"><%= d[:round] %></td>
                <td><%= d[:symbol] %></td>
                <td><%= compact(units(d[:total], d[:decimals])) %></td>
                <td><%= d[:recipients] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @distributions[:items].empty? %><div class="muted small pad">No payout rounds indexed.</div><% end %>
      </div>
      <% end %>
      <div data-tabs-target="panel" data-tab="burns" class="scroll" data-live="burns" hidden>
        <% burner = { r[:deployer] => "creator", r[:creatorFeeRecipient] => "fee recipient",
                      current_chain.addr(:locker) => "locker · protocol share", current_chain.addr(:multi_locker) => "locker · protocol share",
                      current_chain.addr(:burn_vault) => "buyback & burn vault", current_chain.addr(:floor_vault) => "floor vault" } %>
        <p class="small muted"><%= compact(units(r[:burnedToken])) %> <%= r[:symbol] %> burned in total<%= " · showing the latest 100" if @burn_total > 100 %></p>
        <table class="table small">
          <thead><tr><th>Age</th><th>Amount</th><th>Burned by</th></tr></thead>
          <tbody>
            <% @burns.each do |b| %>
              <tr>
                <td><%= explorer(current_chain, "tx", b.tx_hash, ago(b.ts)) %></td>
                <td><%= compact(units(b.amount)) %></td>
                <td class="mono"><%= explorer(current_chain, "address", b.from_addr) %><% if burner[b.from_addr] %> <span class="tag"><%= burner[b.from_addr] %></span><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @burns.empty? %><div class="muted small pad">No burns.</div><% end %>
      </div>
      <% if @floor %>
      <div data-tabs-target="panel" data-tab="floor" class="scroll" hidden>
        <p class="small muted">Every placement of the <%= r[:quoteSymbol] %> wall, newest first. The floor price only ever rises.</p>
        <table class="table small">
          <thead><tr><th>Age</th><th>Floor</th><th>Quote in wall</th><th>Circulating</th></tr></thead>
          <tbody>
            <% (@floor[:history] || []).reverse.first(200).each do |w| %>
              <tr>
                <td><%= explorer(current_chain, "tx", w[:txHash], ago(w[:timestamp])) %></td>
                <td><% if w[:floorPriceEth] %><% if @ref_usd.positive? %>$<%= price(w[:floorPriceEth] * @ref_usd) %><% else %><%= price(w[:floorPriceEth]) %><% end %><% else %><span class="muted">none</span><% end %></td>
                <td><%= compact(units(w[:quoteInWall], r[:quoteDecimals] || 18)) %> <%= r[:quoteSymbol] %></td>
                <td><%= compact(units(w[:circulating])) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% if @floor[:history].blank? %><div class="muted small pad">No wall placements indexed.</div><% end %>
      </div>
      <% end %>
      <div data-tabs-target="panel" data-tab="info" hidden>
        <table class="table small"><tbody>
          <tr><td class="muted">Kind</td><td><%= r[:kind] == "multi" ? "multi-market (#{r[:marketCount]})" : "single market" %></td></tr>
          <% (r[:markets] || [r]).each_with_index do |m, i| %>
            <tr><td class="muted">Market <%= i %></td><td>vs <%= m[:quoteSymbol] %> <span class="tag"><%= m[:quoteRisk] %></span> · pool <span class="mono"><%= short(m[:poolId]) %></span> · position #<%= m[:positionId] %></td></tr>
          <% end %>
          <tr><td class="muted">Supply</td><td><%= compact(units(r[:supply])) %></td></tr>
          <tr><td class="muted">Launch tx</td><td><%= explorer(current_chain, "tx", r[:launchTx]) %> (block <%= r[:createdBlock] %>)</td></tr>
          <tr><td class="muted">Factory</td><td class="mono"><%= r[:factory] %></td></tr>
        </tbody></table>
      </div>
    </div>
  </div>

  <div class="col-side">
    <%= render "tokens/trade", r: %>
    <%= render("tokens/floor_card", r:) if @floor %>
    <%= render("tokens/rewards_card", r:) if @distributions %>
    <%= render "tokens/fees", r: %>
  </div>
</div>
