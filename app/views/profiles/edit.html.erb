<% content_for :title, t("profile.title") %>
<div class="narrow">
  <h1><%= t("profile.title") %></h1>
  <% if current_wallet.nil? %>
    <%= render "shared/signin", why: t("profile.why") %>
  <% else %>
    <div class="row gap between wrap" data-controller="siwe">
      <p class="muted mono small"><%= t("profile.signed_in_as", who: current_wallet) %></p>
      <div class="row gap">
        <%= link_to t("profile.view_portfolio"), portfolio_path(owner: current_wallet), class: "btn" %>
        <button class="btn" data-action="siwe#signOut"><%= t("profile.sign_out") %></button>
      </div>
    </div>

    <%= form_with model: @profile, url: profile_path, method: :patch, class: "card stack" do |f| %>
      <h3><%= t("profile.about") %></h3>
      <% if @profile.errors.any? %><div class="msg err"><%= @profile.errors.full_messages.to_sentence %></div><% end %>
      <div class="form">
        <label><span class="lbl"><%= t("profile.name") %> <span class="hint"><%= t("profile.max_chars", n: 32) %></span></span><%= f.text_field :name, class: "input", maxlength: 32 %></label>
        <label><span class="lbl"><%= t("create.image_link") %> <span class="hint">ipfs:// / https://</span></span><%= f.text_field :avatar, class: "input", placeholder: "ipfs://…" %></label>
        <label class="span2"><span class="lbl"><%= t("profile.bio") %> <span class="hint"><%= t("profile.max_chars", n: 280) %></span></span><%= f.text_area :bio, class: "input", rows: 3, maxlength: 280 %></label>
                  <% Profile::SOCIALS.each do |k| %>
            <label><span class="lbl"><%= k == "twitter" ? "X / Twitter" : t("create.social.#{k}") %> <span class="hint"><%= t("create.optional_url") %></span></span><%= text_field_tag "profile[socials][#{k}]", @profile.socials[k], class: "input", placeholder: "https://" %></label>
          <% end %>
      </div>
      <p class="small muted"><%= t("profile.rules") %></p>
      <div><%= f.submit t("profile.save"), class: "btn primary" %></div>
    <% end %>

    <section class="card stack">
      <h3><%= t("profile.your_tokens") %></h3>
      <% if @tokens.blank? %>
        <p class="small muted"><%= t("profile.no_tokens") %></p>
      <% else %>
        <p class="small muted"><%= t("profile.tokens_lead") %></p>
        <table class="table small">
          <tbody>
            <% @tokens.each do |l| chain = Par::Chains.get(l.chain_id) %>
              <tr>
                <td><%= link_to "#{l.name} $#{l.symbol}", token_path(chain: chain.slug, token: l.token) %></td>
                <td class="muted"><%= ParHelper::CHAIN_SHORT[chain.slug] %></td>
                <td class="right"><%= link_to t("token.edit_details"), edit_token_path(chain: chain.slug, token: l.token) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </section>
  <% end %>
</div>
