#!/usr/bin/env bash
# Sends this app's transactions for real on a throwaway local fork of Robinhood Chain and checks the results:
# the site's launch form (test/fork/launch_form.mjs), the token page's buy/sell box (test/fork/trade_form.mjs) and the MCP build_launch / build_trade transactions
# (test/fork/server_txs.rb). Needs Foundry's anvil, node_modules and a local database with rh indexed.
# Nothing touches a real chain: anvil forks the public RPC read-only and signs with its own dev keys.
#
#   bin/fork-test            # both
#   bin/fork-test form       # only the site's forms (launch, buy/sell)
#   bin/fork-test server     # only the server-built transactions
set -euo pipefail
cd "$(dirname "$0")/.."

# anvil from PATH if it runs (a mise shim without a pinned version does not), else the newest mise install
if anvil --version >/dev/null 2>&1; then ANVIL=anvil
else ANVIL=$(ls -d ~/.local/share/mise/installs/foundry/*/anvil 2>/dev/null | sort -V | tail -1)
fi
[ -n "${ANVIL:-}" ] || { echo "anvil not found: install Foundry"; exit 2; }
UPSTREAM=${FORK_UPSTREAM:-https://rpc.mainnet.chain.robinhood.com}
PORT=${FORK_PORT:-$(ruby -rsocket -e 's = TCPServer.new("127.0.0.1", 0); puts s.addr[1]; s.close')}
RPC="http://127.0.0.1:$PORT"

"$ANVIL" --fork-url "$UPSTREAM" --port "$PORT" --silent &
PID=$!
trap 'kill $PID 2>/dev/null || true' EXIT
for _ in $(seq 1 60); do
  curl -sf -X POST -H 'content-type: application/json' --data '{"jsonrpc":"2.0","id":1,"method":"eth_chainId","params":[]}' "$RPC" >/dev/null && break
  sleep 1
done
echo "fork of $UPSTREAM at $RPC"

status=0
if [ "${1:-all}" != server ]; then
  FORK_RPC=$RPC node test/fork/launch_form.mjs || status=1
  FORK_RPC=$RPC node test/fork/trade_form.mjs || status=1
fi
if [ "${1:-all}" != form ]; then
  PAR_RPC_URL_4663=$RPC PAR_RPS_4663=50 FORK_CHAIN=rh bin/rails runner test/fork/server_txs.rb 2>&1 | grep -v -i "gemspec\|benchmark into" || status=1
  [ "${PIPESTATUS[0]}" -eq 0 ] || status=1
fi
exit $status
